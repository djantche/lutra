    "react-i18next": "^18.0.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "45.3.2",
    "electron-builder": "^26.18.0",
    "sass-embedded": "^1.108.1",
    "simple-icons": "^16.37.0",
